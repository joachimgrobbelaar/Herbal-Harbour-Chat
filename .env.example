# Meta Webhook Verification (Set this token in Meta App Dashboard Webhooks configuration)
META_VERIFY_TOKEN=herbal_harbour_verify_secret_token
META_APP_SECRET=your_meta_app_secret_here

# WhatsApp Cloud API Settings (from Meta for Developers App -> WhatsApp -> API Setup)
WHATSAPP_API_TOKEN=your_whatsapp_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_API_VERSION=v21.0

# Instagram Graph API Settings (from Meta for Developers App -> Instagram Graph API)
INSTAGRAM_PAGE_ACCESS_TOKEN=your_instagram_page_access_token_here
INSTAGRAM_PAGE_ID=your_facebook_page_or_instagram_business_id_here
INSTAGRAM_API_VERSION=v21.0

# LLM Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Server Host and Port
PORT=8000
HOST=0.0.0.0

# WhatsApp QR Bridge (Baileys) Settings (No Meta Account Required)
WHATSAPP_BRIDGE_URL=http://localhost:3001
WHATSAPP_BRIDGE_PORT=3001

# Instagram Private Web API Settings (instagrapi - No Meta Developer App Required)
INSTAGRAM_USERNAME=your_instagram_username_here
INSTAGRAM_PASSWORD=your_instagram_password_here
INSTAGRAM_POLL_INTERVAL=10
